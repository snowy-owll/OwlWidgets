<!--
    The buttons of the card in its button corner: move, above all windows, collapse, the collapse one outermost.
    Every style gives them its look by the resources CornerButtonStyle (a Button style) and CornerIconSize (the icon, px).
    The icons are drawn, not glyphs of a font, in a box of 12 by 12.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="clr-namespace:OwlWidgets.Widgets.SystemMonitor.Properties;assembly=OwlWidgets.Widgets.SystemMonitor.Descriptor"
    xmlns:vms="clr-namespace:OwlWidgets.Widgets.SystemMonitor.ViewModels">

    <Style x:Key="CornerIconStyle" TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <DataTemplate x:Key="CardButtons" DataType="{x:Type vms:ContentViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="Move"
                Grid.Column="0"
                Command="{Binding MoveCommand}"
                Style="{DynamicResource CornerButtonStyle}"
                ToolTip="{x:Static p:Strings.Move}">
                <Viewbox Width="{DynamicResource CornerIconSize}" Height="{DynamicResource CornerIconSize}">
                    <!--  The arrows of the move button of Internet Speed  -->
                    <Path Data="M6,0.5 V11.5 M0.5,6 H11.5 M4,2.5 L6,0.5 L8,2.5 M4,9.5 L6,11.5 L8,9.5 M2.5,4 L0.5,6 L2.5,8 M9.5,4 L11.5,6 L9.5,8" Style="{StaticResource CornerIconStyle}" />
                </Viewbox>
            </Button>
            <Button
                Grid.Column="1"
                Command="{Binding ToggleTopmostCommand}"
                Style="{DynamicResource CornerButtonStyle}">
                <Button.ToolTip>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{x:Static p:Strings.Pin}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                        <Setter Property="Text" Value="{x:Static p:Strings.Unpin}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button.ToolTip>
                <Viewbox Width="{DynamicResource CornerIconSize}" Height="{DynamicResource CornerIconSize}">
                    <!--  A push pin: tilted and hollow under the windows, upright and filled above them  -->
                    <Path Data="M3.5,1 H8.5 M4.8,1 V4.6 L3,6.8 H9 L7.2,4.6 V1 Z M6,6.8 V11.5" RenderTransformOrigin="0.5,0.5">
                        <Path.Style>
                            <Style BasedOn="{StaticResource CornerIconStyle}" TargetType="Path">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="45" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                        <Setter Property="RenderTransform" Value="{x:Null}" />
                                        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Viewbox>
            </Button>
            <Button
                x:Name="Toggle"
                Grid.Column="2"
                Command="{Binding ToggleCollapsedCommand}"
                Style="{DynamicResource CornerButtonStyle}">
                <Button.ToolTip>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{x:Static p:Strings.Collapse}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                        <Setter Property="Text" Value="{x:Static p:Strings.Expand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button.ToolTip>
                <Viewbox Width="{DynamicResource CornerIconSize}" Height="{DynamicResource CornerIconSize}">
                    <!--  Towards the corner of the buttons when the card collapses, away from it when it expands  -->
                    <Path>
                        <Path.Style>
                            <Style BasedOn="{StaticResource CornerIconStyle}" TargetType="Path">
                                <Setter Property="Data" Value="M2,4 L6,8 L10,4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChevronUp}" Value="True">
                                        <Setter Property="Data" Value="M2,8 L6,4 L10,8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Viewbox>
            </Button>
        </Grid>
        <DataTemplate.Triggers>
            <!--  In a left corner the collapse button is the outer one there  -->
            <DataTrigger Binding="{Binding ButtonsAtLeft}" Value="True">
                <Setter TargetName="Move" Property="Grid.Column" Value="2" />
                <Setter TargetName="Toggle" Property="Grid.Column" Value="0" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
