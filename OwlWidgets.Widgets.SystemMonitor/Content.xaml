<UserControl
    x:Class="OwlWidgets.Widgets.SystemMonitor.Content"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OwlWidgets.Widgets.SystemMonitor.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:OwlWidgets.Widgets.SystemMonitor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:OwlWidgets.Widgets.SystemMonitor.Properties;assembly=OwlWidgets.Widgets.SystemMonitor.Descriptor"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:OwlWidgets.UI.Common.Converters;assembly=OwlWidgets.UI.Common"
    xmlns:vms="clr-namespace:OwlWidgets.Widgets.SystemMonitor.ViewModels"
    d:DataContext="{d:DesignInstance Type=vms:ContentViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OwlWidgets.UI.Common;component/Themes/Card.xaml" />
                <ResourceDictionary Source="/OwlWidgets.Widgets.SystemMonitor;component/CardButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  The round buttons of Internet Speed, light over the blue header and the dark card  -->
            <sys:Double x:Key="CornerIconSize">11</sys:Double>
            <Style x:Key="CornerButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#B8FFFFFF" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Chrome"
                                Width="24"
                                Height="24"
                                Background="Transparent"
                                CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#40FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ui:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />

            <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border
                                    x:Name="PART_Track"
                                    Background="#33FFFFFF"
                                    CornerRadius="3" />
                                <Border
                                    x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Utilities  -->
            <SolidColorBrush x:Key="GreenBrush" Color="#2ecc71" />
            <SolidColorBrush x:Key="YellowBrush" Color="#f39c12" />
            <SolidColorBrush x:Key="RedBrush" Color="#e74c3c" />
            <SolidColorBrush x:Key="BlueBrush" Color="#3498db" />
            <SolidColorBrush x:Key="GrayBrush" Color="#BBBBBB" />
            <converters:UsageToBrushConverter
                x:Key="UsageToBrushConverter"
                HighUsageBrush="{StaticResource RedBrush}"
                LowUsageBrush="{StaticResource GreenBrush}"
                MediumUsageBrush="{StaticResource YellowBrush}" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <!--  The line between sections: above every section but the first one shown  -->
            <Thickness x:Key="SectionLine">0,1,0,0</Thickness>
            <Thickness x:Key="NoSectionLine">0</Thickness>

            <!--  The temperature of the processor or of a video card  -->
            <DataTemplate x:Key="TemperatureTile" DataType="{x:Type vms:TemperatureTile}">
                <Border
                    Margin="4"
                    Padding="8,8,8,6"
                    Background="#14FFFFFF"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="TileName" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconBootstrapIcons
                                Margin="0,2,6,0"
                                VerticalAlignment="Top"
                                Foreground="#BBBBBB">
                                <iconPacks:PackIconBootstrapIcons.Style>
                                    <Style TargetType="iconPacks:PackIconBootstrapIcons">
                                        <Setter Property="Kind" Value="GpuCard" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCpu}" Value="True">
                                                <Setter Property="Kind" Value="CpuFill" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconBootstrapIcons.Style>
                            </iconPacks:PackIconBootstrapIcons>
                            <!--  At most two lines, the rest under an ellipsis and in the tooltip  -->
                            <TextBlock
                                Grid.Column="1"
                                MaxHeight="34"
                                FontSize="13"
                                Foreground="#DDDDDD"
                                LineHeight="17"
                                LineStackingStrategy="BlockLineHeight"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTip="{Binding Name}" />
                        </Grid>

                        <local:CircularProgressIndicator
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            DecimalPlaces="0"
                            Maximum="{Binding TemperatureMax}"
                            MaximumColor="{StaticResource RedBrush}"
                            MaxValue="100"
                            Minimum="{Binding TemperatureMin}"
                            MinimumColor="{StaticResource GrayBrush}"
                            Unit="°C"
                            Value="{Binding Temperature}">
                            <local:CircularProgressIndicator.Style>
                                <Style TargetType="local:CircularProgressIndicator">
                                    <Setter Property="Color" Value="{StaticResource GreenBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCpu}" Value="True">
                                            <Setter Property="Color" Value="{StaticResource YellowBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:CircularProgressIndicator.Style>
                        </local:CircularProgressIndicator>

                        <!--  Why there is no temperature; once shown, its line stays  -->
                        <TextBlock
                            Grid.Row="2"
                            FontSize="11"
                            Foreground="#BBBBBB"
                            Text="{Binding Hint}"
                            TextAlignment="Center"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Hint}" Value="{x:Null}" />
                                                <Condition Binding="{Binding KeepsHintLine}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        The whole card keeps its place while it is collapsed, only hidden: the window keeps its size and the buttons
        stay where they are. The collapsed card stands in the corner of the buttons over it. Which one is shown,
        and the animation between them, is up to CollapseAnimation in the code-behind.
    -->
    <Grid>
    <Border
        x:Name="FullCard"
        Width="400"
        Background="{Binding CardBackground}"
        Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header with date and time; in a top corner the buttons are a row above the column of that side  -->
            <Border
                Grid.Row="0"
                Background="{StaticResource BlueBrush}"
                CornerRadius="20,20,0,0">
                <Grid Margin="20,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <ContentControl
                            Margin="-12,-9,0,0"
                            HorizontalAlignment="Left"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource CardButtons}"
                            Focusable="False"
                            Visibility="{Binding ButtonCorner, Converter={StaticResource EqualsToVisibility}, ConverterParameter=TopLeft}" />
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding CurrentTime}" />
                        <TextBlock
                            FontSize="15"
                            Foreground="White"
                            Text="{Binding CurrentDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ContentControl
                            Margin="0,-9,-12,0"
                            HorizontalAlignment="Right"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource CardButtons}"
                            Focusable="False"
                            Visibility="{Binding ButtonCorner, Converter={StaticResource EqualsToVisibility}, ConverterParameter=TopRight}" />
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                Foreground="White"
                                Kind="Display" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{x:Static p:Strings.Name}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  In a bottom corner the buttons have a row of their own under the sections  -->
            <ContentControl
                Grid.Row="4"
                Margin="8,0,8,8"
                Content="{Binding}"
                ContentTemplate="{StaticResource CardButtons}"
                Focusable="False"
                Visibility="{Binding ButtonsAtTop, Converter={StaticResource EqualsToVisibility}, ConverterParameter=False}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ButtonsAtLeft}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!--  Disk Space Section  -->
            <Border Grid.Row="1" Visibility="{Binding ShowDrives, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Margin="20,15,20,10">
                    <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons
                            Margin="0,0,8,0"
                            Foreground="#BBBBBB"
                            Kind="HddFill" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#BBBBBB"
                            Text="{x:Static p:Strings.DiskSpace}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Grid.Column="0"
                                    Margin="0,5"
                                    Padding="10"
                                    Background="#14FFFFFF"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock
                                                Margin="0,0,0,5"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                Foreground="White"
                                                Text="{Binding Name}" />
                                            <StackPanel
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#BBBBBB"
                                                    Text="{Binding UsedSpace, StringFormat={x:Static p:Strings.Format_Gigabytes}}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#BBBBBB"
                                                    Text=" / " />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#BBBBBB"
                                                    Text="{Binding TotalSpace, StringFormat={x:Static p:Strings.Format_GigabytesUsed}}" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar
                                            Height="6"
                                            Foreground="{Binding UsagePercentage, Converter={StaticResource UsageToBrushConverter}}"
                                            Maximum="100"
                                            Style="{StaticResource ProgressBarStyle}"
                                            Value="{Binding UsagePercentage, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  System Usage Section  -->
            <Border
                Grid.Row="2"
                BorderBrush="#22FFFFFF"
                Visibility="{Binding ShowSystem, Converter={StaticResource BooleanToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="{StaticResource SectionLine}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SystemIsFirst}" Value="True">
                                <Setter Property="BorderThickness" Value="{StaticResource NoSectionLine}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="20,15,20,10">
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons
                            Margin="0,0,8,0"
                            Foreground="#BBBBBB"
                            Kind="MotherboardFill" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#BBBBBB"
                            Text="{x:Static p:Strings.System}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  System Stats  -->
                        <StackPanel>
                            <!--  CPU Usage  -->
                            <StackPanel Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="#DDDDDD"
                                        Text="{x:Static p:Strings.CpuUsage}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding CpuUsagePercentage, StringFormat={}{0:F0}%}" />
                                </Grid>
                                <ProgressBar
                                    Height="6"
                                    Margin="0,5,0,0"
                                    Foreground="{Binding CpuUsagePercentage, Converter={StaticResource UsageToBrushConverter}}"
                                    Maximum="100"
                                    Style="{StaticResource ProgressBarStyle}"
                                    Value="{Binding CpuUsagePercentage}" />
                            </StackPanel>

                            <!--  RAM Usage  -->
                            <StackPanel Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="#DDDDDD"
                                        Text="{x:Static p:Strings.RamUsage}" />
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding UsedRam, StringFormat={}{0:.#}/}" />
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding TotalRam, StringFormat={x:Static p:Strings.Format_Gigabytes}}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar
                                    Height="6"
                                    Margin="0,5,0,0"
                                    Foreground="{Binding RamUsagePercentage, Converter={StaticResource UsageToBrushConverter}}"
                                    Maximum="100"
                                    Style="{StaticResource ProgressBarStyle}"
                                    Value="{Binding RamUsagePercentage}" />
                            </StackPanel>

                            <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding GpuUsage}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Foreground="#DDDDDD"
                                                    Text="{Binding Name, StringFormat={x:Static p:Strings.Format_Usage}}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding UsagePercentage, StringFormat={}{0:F0}%}" />
                                            </Grid>
                                            <ProgressBar
                                                Height="6"
                                                Margin="0,5,0,0"
                                                Foreground="{Binding UsagePercentage, Converter={StaticResource UsageToBrushConverter}}"
                                                Maximum="100"
                                                Style="{StaticResource ProgressBarStyle}"
                                                Value="{Binding UsagePercentage}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Temperature Section: the processor, then the video cards, two tiles in a row  -->
            <Border
                Grid.Row="3"
                BorderBrush="#22FFFFFF"
                Visibility="{Binding ShowTemperatures, Converter={StaticResource BooleanToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="{StaticResource SectionLine}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TemperaturesIsFirst}" Value="True">
                                <Setter Property="BorderThickness" Value="{StaticResource NoSectionLine}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="20,15,20,15">
                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons
                            Margin="0,0,8,0"
                            Foreground="#BBBBBB"
                            Kind="ThermometerHalf" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#BBBBBB"
                            Text="{x:Static p:Strings.Temperature}" />
                    </StackPanel>

                    <!--
                        The tiles of a row are as high as the highest of them; the names of all tiles take the same height,
                        so a name on two lines does not move the rings out of line
                    -->
                    <ItemsControl
                        Margin="-4,0"
                        Grid.IsSharedSizeScope="True"
                        ItemTemplate="{StaticResource TemperatureTile}"
                        ItemsSource="{Binding Temperatures}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:TileRowsPanel Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <!--  Collapsed: the badge of the header, the values in one or two lines, the buttons in their corner  -->
    <Border
        x:Name="CollapsedCard"
        Width="400"
        Padding="8,8,10,8"
        Background="{Binding CardBackground}"
        Visibility="Hidden">
        <Border.Style>
            <Style BasedOn="{StaticResource CardStyle}" TargetType="Border">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ButtonsAtTop}" Value="False">
                        <Setter Property="VerticalAlignment" Value="Bottom" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ButtonsAtLeft}" Value="True">
                        <Setter Property="Padding" Value="10,8,8,8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <ContentControl
                Height="30"
                Content="{Binding}"
                ContentTemplate="{StaticResource CardButtons}"
                Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="DockPanel.Dock" Value="Right" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="Margin" Value="8,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ButtonsAtLeft}" Value="True">
                                <Setter Property="DockPanel.Dock" Value="Left" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ButtonsAtTop}" Value="False">
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <Border
                Width="30"
                Height="30"
                Margin="0,0,10,0"
                VerticalAlignment="Top"
                Background="{StaticResource BlueBrush}"
                CornerRadius="15"
                DockPanel.Dock="Left">
                <iconPacks:PackIconBootstrapIcons
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Kind="Display" />
            </Border>
            <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding CollapsedValues}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vms:CollapsedValue}">
                        <StackPanel
                            Height="30"
                            Margin="0,0,14,0"
                            Background="Transparent"
                            Orientation="Horizontal"
                            ToolTip="{Binding ToolTip}">
                            <iconPacks:PackIconBootstrapIcons
                                x:Name="Icon"
                                Width="15"
                                Height="15"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="#5DADE2"
                                Kind="GpuCard"
                                Visibility="{Binding IsTemperature, Converter={StaticResource BooleanToVisibility}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="#DDDDDD"
                                Text="{Binding Label}" />
                            <TextBlock
                                x:Name="Value"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource GrayBrush}"
                                Text="{Binding Text}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCpu}" Value="True">
                                <Setter TargetName="Icon" Property="Kind" Value="CpuFill" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Low">
                                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource GreenBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Medium">
                                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource YellowBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="High">
                                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource RedBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
    </Grid>
</UserControl>
