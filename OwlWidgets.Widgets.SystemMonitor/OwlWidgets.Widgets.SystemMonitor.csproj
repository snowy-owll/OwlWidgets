<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Structures of pdh.dll and of the kernel thunks of gdi32.dll (Sensors/Native). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <WidgetFolder>SystemMonitor</WidgetFolder>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OwlWidgets.Common\OwlWidgets.Common.csproj" />
    <ProjectReference Include="..\OwlWidgets.Contracts\OwlWidgets.Contracts.csproj" />
    <ProjectReference Include="..\OwlWidgets.UI.Common\OwlWidgets.UI.Common.csproj" />
    <ProjectReference Include="..\OwlWidgets.Widgets.SystemMonitor.Descriptor\OwlWidgets.Widgets.SystemMonitor.Descriptor.csproj" />
  </ItemGroup>

  <Import Project="..\WidgetPackage.targets" />

  <ItemGroup>
    <PropertyPageSchema Remove="Content.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.BootstrapIcons" Version="5.1.0" />
  </ItemGroup>

</Project>
