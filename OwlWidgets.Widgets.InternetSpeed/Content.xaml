<UserControl
    x:Class="OwlWidgets.Widgets.InternetSpeed.Content"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OwlWidgets.Widgets.InternetSpeed"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:OwlWidgets.Widgets.InternetSpeed.Properties;assembly=OwlWidgets.Widgets.InternetSpeed.Descriptor"
    xmlns:vms="clr-namespace:OwlWidgets.Widgets.InternetSpeed.ViewModels"
    d:DataContext="{d:DesignInstance Type=vms:ContentViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OwlWidgets.UI.Common;component/Themes/Card.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="SecondaryBrush" Color="#9ca3af" />
            <!--  The colours of the two directions, as on Speedtest: cyan for the download, violet for the upload.  -->
            <SolidColorBrush x:Key="DownloadBrush" Color="#22d3ee" />
            <SolidColorBrush x:Key="UploadBrush" Color="#a78bfa" />

            <LinearGradientBrush x:Key="StartRingBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#22d3ee" />
                <GradientStop Offset="1" Color="#a78bfa" />
            </LinearGradientBrush>

            <!--  The round button in the middle of the gauge.  -->
            <Style x:Key="StartButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="100" Height="100">
                                <Ellipse
                                    x:Name="Fill"
                                    Fill="#1AFFFFFF"
                                    Stroke="{StaticResource StartRingBrush}"
                                    StrokeThickness="3" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fill" Property="Fill" Value="#33FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fill" Property="Fill" Value="#4DFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ResultStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!--  The small buttons in the top corner: hide or show the card, move it.  -->
            <Style x:Key="CornerButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Chrome"
                                Width="24"
                                Height="24"
                                Background="Transparent"
                                CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#40FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlyphStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="RunningOnly" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        Code-behind puts the card, its content, the icon and the buttons in ButtonCorner and animates the size.
        While the card is hidden or on its way, the frame keeps the size of the shown card: the window of the wrapper
        does not change its size frame by frame. A transparent window that changes its size and position shows its
        new picture a moment later than its new place, and the card would shake. Around a hidden card the frame is
        transparent, and clicks there go through to the desktop.
    -->
    <Grid x:Name="Frame">
        <Border
            x:Name="Card"
            Padding="10,8"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid x:Name="Body" ClipToBounds="True">
                    <!--  A hidden card: the icon next to the buttons, with the last result in the tooltip.  -->
                    <Image
                        x:Name="Icon"
                        Width="28"
                        Height="28"
                        Margin="0,0,54,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Opacity="0"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="pack://application:,,,/OwlWidgets.Widgets.InternetSpeed.Descriptor;component/Assets/Icon.png"
                        ToolTip="{Binding Summary}"
                        Visibility="Hidden" />

                    <!--  Fixed width: while the card shrinks, the content is cut on the side away from the buttons.  -->
                    <StackPanel
                        x:Name="Expanded"
                        Width="268"
                        Margin="5,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                        <TextBlock
                            Margin="52,0"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryBrush}"
                            Text="{Binding Server}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />

                        <Grid
                            Width="220"
                            Height="190"
                            Margin="0,6,0,0">
                            <!--  The needle only while data moves: the server search and the ping have their caption alone.  -->
                            <local:SpeedGauge Value="{Binding Speed}">
                                <local:SpeedGauge.Style>
                                    <Style TargetType="local:SpeedGauge">
                                        <Setter Property="Accent" Value="{StaticResource DownloadBrush}" />
                                        <Setter Property="Opacity" Value="0.5" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Phase}" Value="Download">
                                                <Setter Property="IsActive" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Phase}" Value="Upload">
                                                <Setter Property="Accent" Value="{StaticResource UploadBrush}" />
                                                <Setter Property="IsActive" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:SpeedGauge.Style>
                            </local:SpeedGauge>

                            <!--  Idle: the button over the hub. The test starts here and in the refresh button after a failure.  -->
                            <Button
                                Margin="0,60,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Command="{Binding StartCommand}"
                                ToolTip="{x:Static p:Strings.Start_ToolTip}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource StartButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="{x:Static p:Strings.Start}" />
                            </Button>

                            <!--  Running: the current speed in the opening of the arc, under the hub.  -->
                            <StackPanel
                                Margin="0,0,0,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource RunningOnly}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryBrush}"
                                    Text="{Binding PhaseText}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding SpeedText}" />
                                <Button
                                    Margin="0,2,0,0"
                                    Padding="10,2"
                                    HorizontalAlignment="Center"
                                    Command="{Binding StopCommand}"
                                    Content="{x:Static p:Strings.Stop}"
                                    FontSize="11"
                                    Style="{StaticResource CardButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource CaptionStyle}">
                                    <Run Foreground="#fbbf24" Text="◷" />
                                    <Run Text="{x:Static p:Strings.Ping}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ResultStyle}" Text="{Binding Ping}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Static p:Strings.Unit_Ms}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource CaptionStyle}">
                                    <Run Foreground="{StaticResource DownloadBrush}" Text="↓" />
                                    <Run Text="{x:Static p:Strings.Download}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ResultStyle}" Text="{Binding Download}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Static p:Strings.Unit_Mbps}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource CaptionStyle}">
                                    <Run Foreground="{StaticResource UploadBrush}" Text="↑" />
                                    <Run Text="{x:Static p:Strings.Upload}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ResultStyle}" Text="{Binding Upload}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Static p:Strings.Unit_Mbps}" />
                            </StackPanel>
                        </Grid>

                        <!--  Jitter under the results: one line, so the columns stay level; its place stays without it, so the card keeps its height.  -->
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryBrush}"
                            Text="{Binding Jitter}"
                            TextAlignment="Center" />

                        <!--  Code-behind keeps it clear of buttons in a bottom corner.  -->
                        <DockPanel
                            x:Name="StatusLine"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Right">
                            <!--  The test failed: test again now.  -->
                            <Button
                                Margin="4,0,-4,0"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshCommand}"
                                DockPanel.Dock="Right">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource CardRefreshButtonStyle}" TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryBrush}"
                                Text="{Binding Status}"
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <!--  Outside the clip of the body: the buttons stay in their corner in both states. The hide button is the outer one.  -->
                <StackPanel
                    x:Name="Buttons"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding MoveCommand}"
                        Style="{StaticResource CornerButtonStyle}"
                        ToolTip="{x:Static p:Strings.Move}">
                        <!--  Drawn, not the "Move" glyph: Segoe MDL2 Assets of Windows 10 has no E7C2, only Segoe Fluent Icons of Windows 11.  -->
                        <Path
                            Width="11"
                            Height="11"
                            Data="M6,0.5 V11.5 M0.5,6 H11.5 M4,2.5 L6,0.5 L8,2.5 M4,9.5 L6,11.5 L8,9.5 M2.5,4 L0.5,6 L2.5,8 M9.5,4 L11.5,6 L9.5,8"
                            Stretch="Uniform"
                            Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1" />
                    </Button>
                    <Button x:Name="ToggleButton" Command="{Binding ToggleCollapsedCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource CornerButtonStyle}" TargetType="Button">
                                <Setter Property="ToolTip" Value="{x:Static p:Strings.Collapse}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                        <Setter Property="ToolTip" Value="{x:Static p:Strings.Expand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource GlyphStyle}" TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE70E;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter Property="Text" Value="&#xE70D;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
