<UserControl
    x:Class="OwlWidgets.UI.Common.SettingsPrompt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="clr-namespace:OwlWidgets.UI.Common.Properties"
    x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OwlWidgets.UI.Common;component/Themes/Card.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,4">
        <TextBlock
            FontSize="14"
            Foreground="White"
            Text="{Binding Message, ElementName=Root}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            Margin="0,10,0,2"
            HorizontalAlignment="Center"
            Command="{Binding Command, ElementName=Root}"
            Style="{StaticResource CardButtonStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    Text="&#xE713;" />
                <TextBlock VerticalAlignment="Center" Text="{x:Static p:Strings.OpenSettings}" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
