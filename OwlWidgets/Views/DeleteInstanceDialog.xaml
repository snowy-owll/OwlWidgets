<UserControl x:Class="OwlWidgets.Views.DeleteInstanceDialog" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:OwlWidgets.Properties"
             Width="400">
    <StackPanel Margin="24,24,24,16">
        <TextBlock Text="{x:Static p:Strings.DeleteDialog_Title}" FontSize="22" />
        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" Margin="0,4,0,16" Opacity="0.68"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Static p:Strings.DeleteDialog_Message}" TextWrapping="Wrap" />

        <!-- Cancel is the default: Enter does not delete by accident. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,32,0,0">
            <Button x:Name="CancelButton" Content="{x:Static p:Strings.AddWidget_Cancel}" Style="{StaticResource MaterialDesignFlatButton}"
                    IsCancel="True" IsDefault="True" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <Button Content="{x:Static p:Strings.Widgets_Delete}" MinWidth="100" Command="{Binding DeleteCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
