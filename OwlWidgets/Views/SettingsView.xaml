<UserControl x:Class="OwlWidgets.Views.SettingsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:p="clr-namespace:OwlWidgets.Properties">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static p:Strings.Settings_Title}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,24" />

            <TextBlock Text="{x:Static p:Strings.Appearance}" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
            <ComboBox Width="280" HorizontalAlignment="Left"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="{x:Static p:Strings.Theme}"
                      ItemsSource="{Binding ThemeOptions}"
                      DisplayMemberPath="Title"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Theme}" />

            <TextBlock Text="{x:Static p:Strings.Settings_Startup}" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,24,0,12" />
            <CheckBox Content="{x:Static p:Strings.Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows}" />
            <CheckBox Content="{x:Static p:Strings.Settings_ShowWindowOnStart}" IsChecked="{Binding ShowWindowOnStart}" Margin="0,8,0,0" />

            <TextBlock Text="{x:Static p:Strings.Settings_Updates}" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,24,0,12" />
            <CheckBox Content="{x:Static p:Strings.Settings_CheckForUpdates}" IsChecked="{Binding CheckForUpdates}" />

            <TextBlock Text="{x:Static p:Strings.Settings_Language}" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,24,0,12" />
            <ComboBox Width="280" HorizontalAlignment="Left"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="{x:Static p:Strings.Settings_InterfaceLanguage}"
                      ItemsSource="{Binding LanguageOptions}"
                      DisplayMemberPath="Title"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Language}" />
            <!-- Shown only while the stored language differs from the one on screen. -->
            <DockPanel Margin="0,12,0,0"
                       Visibility="{Binding RestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="InformationOutline" Width="20" Height="20"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="12,0,0,0"
                        Content="{x:Static p:Strings.Settings_Restart}" Command="{Binding RestartCommand}" />
                <TextBlock Text="{x:Static p:Strings.Settings_RestartRequired}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Style="{StaticResource MaterialDesignBody2TextBlock}" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
