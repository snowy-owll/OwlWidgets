<UserControl x:Class="OwlWidgets.Views.LogEntryDialog" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:p="clr-namespace:OwlWidgets.Properties"
             xmlns:views="clr-namespace:OwlWidgets.Views"
             views:LogTheme.IsDark="{Binding IsDarkTheme}"
             Width="720">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LogLevels.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                <Setter Property="Opacity" Value="0.68" />
                <Setter Property="Margin" Value="0,3,16,3" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <!-- Every value is a read-only text box without decoration: any part of it can be selected and copied. -->
            <Style x:Key="Value" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Hidden" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="24,24,24,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="{x:Static p:Strings.LogEntry_Title}" FontSize="22" VerticalAlignment="Center" Margin="0,0,16,0" />
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LogLevelBadge}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0" Command="{Binding CopyCommand}"
                    ToolTip="{x:Static p:Strings.LogEntry_CopyToolTip}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static p:Strings.LogEntry_Copy}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Content="{x:Static p:Strings.LogEntry_Close}" MinWidth="100"
                    IsDefault="True" IsCancel="True" Command="{Binding CloseCommand}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{x:Static p:Strings.Log_ColumnTime}" Style="{StaticResource Label}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Time, Mode=OneWay}" Style="{StaticResource Value}" FontFamily="Consolas" />

                <TextBlock Grid.Row="1" Text="{x:Static p:Strings.Log_ColumnOrigin}" Style="{StaticResource Label}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Origin, Mode=OneWay}" Style="{StaticResource Value}" />

                <TextBlock Grid.Row="2" Text="{x:Static p:Strings.Widgets_InstanceId}" Style="{StaticResource Label}"
                           Visibility="{Binding HasInstanceId, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InstanceId, Mode=OneWay}" Style="{StaticResource Value}" FontFamily="Consolas"
                         Visibility="{Binding HasInstanceId, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="3" Text="{x:Static p:Strings.Log_ColumnSource}" Style="{StaticResource Label}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Source, Mode=OneWay}" Style="{StaticResource Value}" />

                <TextBlock Grid.Row="4" Text="{x:Static p:Strings.LogEntry_Category}" Style="{StaticResource Label}"
                           Visibility="{Binding HasCategory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Category, Mode=OneWay}" Style="{StaticResource Value}"
                         Visibility="{Binding HasCategory, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="5" Text="{x:Static p:Strings.Log_ColumnMessage}" Style="{StaticResource Label}" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Message, Mode=OneWay}" Style="{StaticResource Value}" />

                <TextBlock Grid.Row="6" Text="{x:Static p:Strings.LogEntry_Exception}" Style="{StaticResource Label}"
                           Visibility="{Binding HasException, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Exception, Mode=OneWay}" Style="{StaticResource Value}"
                         FontFamily="Consolas" FontSize="12"
                         Visibility="{Binding HasException, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
