<UserControl x:Class="OwlWidgets.Views.AddWidgetDialog" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:p="clr-namespace:OwlWidgets.Properties"
             xmlns:ui="clr-namespace:OwlWidgets.UI.Common;assembly=OwlWidgets.UI.Common"
             Width="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <DockPanel Margin="24,24,24,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{x:Static p:Strings.AddWidget_Title}" FontSize="22" />
            <TextBlock Text="{Binding StepText}" Margin="0,4,0,0" Opacity="0.68" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static p:Strings.AddWidget_Back}" Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0" Command="{Binding BackCommand}"
                    Visibility="{Binding SettingsStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="{x:Static p:Strings.AddWidget_Cancel}" Style="{StaticResource MaterialDesignFlatButton}" IsCancel="True"
                    Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <Button MinWidth="100" IsDefault="True" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" />
        </StackPanel>

        <!-- The tag stays under both steps: it belongs to the instance, not to the widget settings.
             Updated on every key: Enter presses the default button without leaving the field. -->
        <TextBox DockPanel.Dock="Bottom" MaxLength="64" Margin="0,16,0,0"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="{x:Static p:Strings.Instance_TagHint}"
                 materialDesign:HintAssist.HelperText="{x:Static p:Strings.Instance_TagHelper}"
                 materialDesign:TextFieldAssist.HasClearButton="True"
                 Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" />

        <Grid>
            <ListBox x:Name="PackageList" MaxHeight="420" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}"
                     Visibility="{Binding ChooseStep, Converter={StaticResource BooleanToVisibilityConverter}}"
                     MouseDoubleClick="PackageList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,6">
                            <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
                                <Image x:Name="IconImage" Source="{Binding Icon}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <materialDesign:PackIcon x:Name="IconPlaceholder" Kind="WidgetsOutline" Width="28" Height="28"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Opacity="0.4" Visibility="Collapsed" />
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding Descriptor.Name}" FontSize="15" FontWeight="Medium" />
                                <TextBlock FontSize="12" Opacity="0.68" Margin="0,2,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1}">
                                            <Binding Path="Descriptor.Version" />
                                            <Binding Path="Descriptor.Author" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock x:Name="DescriptionText" Text="{Binding Descriptor.Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Descriptor.Id, StringFormat={x:Static p:Strings.AddWidget_Id}}"
                                           FontFamily="Consolas" FontSize="11" Opacity="0.5" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                <Setter TargetName="IconPlaceholder" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Descriptor.Description}" Value="">
                                <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding SettingsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:ViewportWidthDecorator>
                    <ContentControl Content="{Binding EditorContent}" Focusable="False" />
                </ui:ViewportWidthDecorator>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
