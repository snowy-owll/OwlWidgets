<UserControl x:Class="OwlWidgets.Views.TagDialog" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:p="clr-namespace:OwlWidgets.Properties"
             Width="400">
    <StackPanel Margin="24,24,24,16">
        <TextBlock Text="{x:Static p:Strings.TagDialog_Title}" FontSize="22" />
        <TextBlock Text="{Binding TypeName}" Margin="0,4,0,16" Opacity="0.68" />

        <!-- Updated on every key: Enter presses the default button without leaving the field. -->
        <TextBox x:Name="TagBox" MaxLength="64" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="{x:Static p:Strings.Instance_TagHint}"
                 materialDesign:HintAssist.HelperText="{x:Static p:Strings.Instance_TagHelper}"
                 materialDesign:TextFieldAssist.HasClearButton="True"
                 Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,32,0,0">
            <Button Content="{x:Static p:Strings.AddWidget_Cancel}" Style="{StaticResource MaterialDesignFlatButton}" IsCancel="True"
                    Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <Button Content="{x:Static p:Strings.TagDialog_Save}" MinWidth="100" IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
