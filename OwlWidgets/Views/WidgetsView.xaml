<UserControl x:Class="OwlWidgets.Views.WidgetsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:p="clr-namespace:OwlWidgets.Properties"
             xmlns:vm="clr-namespace:OwlWidgets.ViewModels"
             xmlns:converters="clr-namespace:OwlWidgets.UI.Common.Converters;assembly=OwlWidgets.UI.Common"
             xmlns:ui="clr-namespace:OwlWidgets.UI.Common;assembly=OwlWidgets.UI.Common"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EqualsToVisibilityConverter x:Key="EqualsToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <!-- Mass move: the same button cancels it while it is on. -->
                <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                        ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MoveAllToolTip}"
                        Command="{Binding MoveAllCommand}">
                    <materialDesign:PackIcon Width="18" Height="18">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="CursorMove" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MassMoveActive}" Value="True">
                                        <Setter Property="Kind" Value="Close" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>
                <TextBlock Text="{x:Static p:Strings.Widgets_Instances}" FontSize="16" VerticalAlignment="Center" />
            </DockPanel>
            <Grid>
                <ListBox x:Name="InstanceList" Padding="0,0,0,72"
                         ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                         SelectionChanged="InstanceList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <!-- State indicator: green (secondary) running, primary in transition,
                                     error while waiting for a restart and after a crash, dim when stopped. -->
                                <Border x:Name="StateBar" DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,0,10,0"
                                        Background="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.25" />
                                <!-- Fixed slot: icons of any size line up; a widget without one gets a dim placeholder. -->
                                <Grid DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Image x:Name="IconImage" Source="{Binding Icon}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <materialDesign:PackIcon x:Name="IconPlaceholder" Kind="WidgetsOutline" Width="22" Height="22"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Opacity="0.4" Visibility="Collapsed" />
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Caption}" FontSize="11" Opacity="0.68" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                    <Setter TargetName="IconPlaceholder" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Running">
                                    <Setter TargetName="StateBar" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                    <Setter TargetName="StateBar" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Starting">
                                    <Setter TargetName="StateBar" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    <Setter TargetName="StateBar" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Stopping">
                                    <Setter TargetName="StateBar" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    <Setter TargetName="StateBar" Property="Opacity" Value="0.6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="RestartBackoff">
                                    <Setter TargetName="StateBar" Property="Background" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                    <Setter TargetName="StateBar" Property="Opacity" Value="0.5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Faulted">
                                    <Setter TargetName="StateBar" Property="Background" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                    <Setter TargetName="StateBar" Property="Opacity" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- The list keeps room at the bottom so the last item is not hidden under the button. -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                        Style="{StaticResource MaterialDesignFloatingActionButton}"
                        ToolTipService.ShowOnDisabled="True" ToolTip="{Binding AddToolTip}"
                        Command="{Binding AddCommand}">
                    <materialDesign:PackIcon Kind="Plus" Width="24" Height="24" />
                </Button>
            </Grid>
        </DockPanel>

        <!-- The pages are not the content of the tab items: a TabItem keeps only the selected content
             in the tree, and the widget settings screen would be detached on every switch.
             Inside Details the data context is the selected instance; the screen model is reached through Root. -->
        <DockPanel Grid.Column="2" DataContext="{Binding SelectedInstance}"
                   Visibility="{Binding DataContext.HasSelection, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0"
                            Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                            ToolTip="{x:Static p:Strings.Widgets_EditTag}"
                            Command="{Binding DataContext.EditTagCommand, ElementName=Root}">
                        <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" />
                    </Button>
                    <Image DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Icon}"
                           Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="20" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding MetaText}" Margin="0,4,0,8" TextWrapping="Wrap" Opacity="0.8" />
                <!-- The identifiers are read-only text boxes without decoration, so they can be selected and copied. -->
                <Grid Margin="0,0,0,12" Opacity="0.8">
                    <Grid.Resources>
                        <Style x:Key="IdText" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="IsReadOnly" Value="True" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Hidden" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static p:Strings.Widgets_InstanceId}" Margin="0,0,12,2" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource IdText}" Margin="0,0,0,2" Text="{Binding InstanceId, Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Text="{x:Static p:Strings.Widgets_TypeId}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource IdText}" Text="{Binding WidgetId, Mode=OneWay}" />
                </Grid>
                <TextBlock Text="{Binding StateText}" FontSize="14" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="{x:Static p:Strings.Widgets_Start}" MinWidth="110" Margin="0,0,8,0" Command="{Binding StartCommand}" />
                    <Button Content="{x:Static p:Strings.Widgets_Stop}" MinWidth="110" Margin="0,0,8,0" Command="{Binding StopCommand}" />
                    <Button Content="{x:Static p:Strings.Widgets_Move}" MinWidth="110" Margin="0,0,8,0" Command="{Binding MoveCommand}" />
                    <Button Content="{x:Static p:Strings.Widgets_Delete}" MinWidth="110"
                            Command="{Binding DataContext.DeleteCommand, ElementName=Root}" />
                </StackPanel>
            </StackPanel>

            <TabControl DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,12"
                        materialDesign:ColorZoneAssist.Mode="Standard"
                        SelectedValuePath="Tag" SelectedValue="{Binding DataContext.SelectedPage, ElementName=Root}">
                <TabItem Tag="{x:Static vm:InstancePage.General}" Height="64">
                    <TabItem.Header>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="TuneVariant" Width="24" Height="24" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Static p:Strings.Widgets_PageGeneral}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <TabItem Tag="{x:Static vm:InstancePage.Widget}" Height="64"
                         Visibility="{Binding HasSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabItem.Header>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="WidgetsOutline" Width="24" Height="24" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Static p:Strings.Widgets_PageWidget}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <TabItem Tag="{x:Static vm:InstancePage.Json}" Height="64">
                    <TabItem.Header>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="CodeJson" Width="24" Height="24" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Static p:Strings.Widgets_PageJson}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
            </TabControl>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding DataContext.SelectedPage, ElementName=Root, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=General}">
                    <StackPanel>
                        <CheckBox Content="{x:Static p:Strings.Widgets_StartWithManager}" Margin="0,0,0,6" IsChecked="{Binding StartWithManager}" />
                        <CheckBox Content="{x:Static p:Strings.Widgets_RestartOnCrash}" Margin="0,0,0,12" IsChecked="{Binding RestartOnCrash}" />

                        <TextBlock Text="{x:Static p:Strings.Appearance}" Margin="0,0,0,4" />
                        <CheckBox Content="{x:Static p:Strings.Widgets_InheritTheme}" Margin="0,0,0,6"
                                  ToolTipService.ShowOnDisabled="True" ToolTip="{Binding InheritThemeHint}"
                                  IsChecked="{Binding InheritHostTheme}" IsEnabled="{Binding CanChangeInheritHostTheme}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{x:Static p:Strings.Theme}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Width="180" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Title"
                                      SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
                        </StackPanel>

                        <!-- The fields are a draft of whole numbers: the check stores and applies them, the cross or Esc
                             puts the stored position back. Enter in a field works as the check. -->
                        <TextBlock Text="{x:Static p:Strings.Widgets_Position}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <!-- The anchor applies at once and puts the position of the new corner into the fields. -->
                            <ui:CornerPicker Corner="{Binding Anchor}" IsEnabled="{Binding CanEditPosition}" Margin="0,0,16,0" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="80" Margin="0,0,12,0" IsEnabled="{Binding CanEditPosition}"
                                         ui:NumericInput.IsEnabled="True" ui:NumericInput.AllowFraction="False"
                                         Text="{Binding PositionX, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ApplyPositionCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding RevertPositionCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="80" Margin="0,0,8,0" IsEnabled="{Binding CanEditPosition}"
                                         ui:NumericInput.IsEnabled="True" ui:NumericInput.AllowFraction="False"
                                         Text="{Binding PositionY, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ApplyPositionCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding RevertPositionCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" VerticalAlignment="Center"
                                        ToolTip="{x:Static p:Strings.Widgets_ApplyPosition}" Command="{Binding ApplyPositionCommand}">
                                    <materialDesign:PackIcon Kind="Check" Width="18" Height="18" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32" VerticalAlignment="Center"
                                        ToolTip="{x:Static p:Strings.Widgets_RevertPosition}" Command="{Binding RevertPositionCommand}">
                                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{x:Static p:Strings.Widgets_AnchorHint}" Margin="0,4,0,0" Opacity="0.6"
                                   TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left" />
                        <CheckBox Content="{x:Static p:Strings.Widgets_Topmost}" Margin="0,12,0,0" IsChecked="{Binding Topmost}" />
                        <TextBlock Text="{x:Static p:Strings.Widgets_TopmostHint}" Margin="0,4,0,0" Opacity="0.6"
                                   TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>

                <DockPanel Visibility="{Binding DataContext.SelectedPage, ElementName=Root, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=Widget}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{x:Static p:Strings.Widgets_SaveSettings}" MinWidth="180" Command="{Binding SaveCommand}" />
                        <Button Content="{x:Static p:Strings.Widgets_RevertSettings}" MinWidth="180" Margin="8,0,0,0"
                                ToolTip="{x:Static p:Strings.Widgets_RevertSettingsHint}" Command="{Binding RevertCommand}"
                                Visibility="{Binding CanSave, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <!-- A screen wider than the window scrolls horizontally; one that fits keeps the window's width. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ui:ViewportWidthDecorator>
                            <ContentControl Content="{Binding SettingsContent}" Focusable="False" />
                        </ui:ViewportWidthDecorator>
                    </ScrollViewer>
                </DockPanel>

                <Grid Visibility="{Binding DataContext.SelectedPage, ElementName=Root, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=Json}">
                    <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding JsonText, Mode=OneWay}"
                             Visibility="{Binding HasJson, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{x:Static p:Strings.Widgets_JsonDefaults}" TextWrapping="Wrap" Opacity="0.68">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasJson}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
