<UserControl x:Class="OwlWidgets.Views.AboutView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:p="clr-namespace:OwlWidgets.Properties">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="Margin" Value="0,2,16,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/Images/icon.png" Width="72" Height="72" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="0,4,0,0">
                        <Run Text="{x:Static p:Strings.About_Version}" /> <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.68" Margin="0,2,0,0">
                        <Run Text="{x:Static p:Strings.About_Build}" /> <Run Text="{Binding Build, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Static p:Strings.About_ReleasedOn}" /> <Run Text="{Binding ReleaseDate, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.68" Margin="0,2,0,0">
                        <Run Text="{x:Static p:Strings.About_Author}" /> <Run Text="{Binding Author, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.68" Margin="0,2,0,0">
                        <Run Text="{x:Static p:Strings.About_Project}" /> <Hyperlink Command="{Binding OpenRepositoryCommand}" ToolTip="{x:Static p:Strings.About_OpenInBrowser}"><Run Text="{Binding Repository, Mode=OneWay}" /></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{x:Static p:Strings.About_Updates}" Style="{StaticResource SectionTitle}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Content="{x:Static p:Strings.About_CheckUpdates}" Command="{Binding CheckUpdatesCommand}" />
                <StackPanel VerticalAlignment="Center">
                    <WrapPanel>
                        <TextBlock Text="{Binding UpdateText, Mode=OneWay}" Style="{StaticResource Value}" Margin="0,2,8,2" />
                        <TextBlock Style="{StaticResource Value}"
                                   Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Hyperlink Command="{Binding OpenReleaseCommand}" ToolTip="{x:Static p:Strings.About_OpenInBrowser}"><Run Text="{x:Static p:Strings.About_OpenRelease}" /></Hyperlink>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Text="{Binding UpdateCheckedAt, Mode=OneWay}" Style="{StaticResource Label}" Margin="0,2,0,0"
                               Visibility="{Binding IsUpdateChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{x:Static p:Strings.About_System}" Style="{StaticResource SectionTitle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Static p:Strings.About_Runtime}" Style="{StaticResource Label}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Runtime, Mode=OneWay}" Style="{StaticResource Value}" />
                <TextBlock Grid.Row="1" Text="{x:Static p:Strings.About_OperatingSystem}" Style="{StaticResource Label}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OperatingSystem, Mode=OneWay}" Style="{StaticResource Value}" />
            </Grid>

            <TextBlock Text="{x:Static p:Strings.About_Folders}" Style="{StaticResource SectionTitle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Static p:Strings.About_Data}" Style="{StaticResource Label}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataFolder, Mode=OneWay}" Style="{StaticResource Value}" />
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                        ToolTip="{x:Static p:Strings.About_OpenData}" Command="{Binding OpenDataCommand}">
                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" />
                </Button>
                <TextBlock Grid.Row="1" Text="{x:Static p:Strings.About_Logs}" Style="{StaticResource Label}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LogsFolder, Mode=OneWay}" Style="{StaticResource Value}" />
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                        ToolTip="{x:Static p:Strings.About_OpenLogs}" Command="{Binding OpenLogsCommand}">
                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" />
                </Button>
            </Grid>

            <TextBlock Text="{x:Static p:Strings.About_InstalledWidgets}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{x:Static p:Strings.About_NoWidgets}" Style="{StaticResource Label}"
                       Visibility="{Binding HasNoWidgets, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding Widgets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Value}" />
                            <TextBlock Style="{StaticResource Value}" Opacity="0.68" Margin="6,2,0,2">
                                <Run Text="{Binding Version, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Author, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{x:Static p:Strings.About_ThirdParty}" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Value}" />
                            <TextBlock Style="{StaticResource Value}" Opacity="0.68" Margin="6,2,0,2">
                                <Run Text="{Binding Version, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding License, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
