<Application x:Class="OwlWidgets.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:OwlWidgets.Views"
             xmlns:vm="clr-namespace:OwlWidgets.ViewModels"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The base theme is replaced at startup from the manager settings. -->
                <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#3D6A9E" SecondaryColor="#43A047" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Screens and dialogs are picked by the type of their model. The widgets and log screens are not here:
                 they are created once, see MainWindow. -->
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AddWidgetViewModel}">
                <views:AddWidgetDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TagViewModel}">
                <views:TagDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogEntryDetailsViewModel}">
                <views:LogEntryDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeleteInstanceViewModel}">
                <views:DeleteInstanceDialog />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
