<Window x:Class="OwlWidgets.WidgetHost.HostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:p="clr-namespace:OwlWidgets.WidgetHost.Properties"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        Topmost="False">
    <!-- The margin around the card is set in code: it leaves room for the shadow of the widget view. -->
    <Grid x:Name="Card">
        <ContentControl x:Name="Root" />
        <!-- Material Design resources are added in code when the frame is first shown. -->
        <Grid x:Name="MoveOverlay"
              Visibility="Collapsed"
              Background="Transparent"
              TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
              MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
            <Border CornerRadius="8"
                    Background="{DynamicResource MaterialDesign.Brush.Background}"
                    Opacity="0.35"
                    IsHitTestVisible="False" />
            <Border CornerRadius="8"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                    BorderThickness="2"
                    IsHitTestVisible="False" />
            <materialDesign:Card HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="8"
                                 Padding="4,2"
                                 UniformCornerRadius="20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CursorMove"
                                             Width="18"
                                             Height="18"
                                             Margin="8,0,4,0"
                                             VerticalAlignment="Center"
                                             Opacity="0.68"
                                             ToolTip="{x:Static p:Strings.Move_DragHint}" />
                    <Button Style="{DynamicResource MaterialDesignIconButton}"
                            Width="32"
                            Height="32"
                            ToolTip="{x:Static p:Strings.Move_Confirm}"
                            Click="Confirm_Click">
                        <materialDesign:PackIcon Kind="Check"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" />
                    </Button>
                    <Button Style="{DynamicResource MaterialDesignIconButton}"
                            Width="32"
                            Height="32"
                            ToolTip="{x:Static p:Strings.Move_Cancel}"
                            Click="Cancel_Click">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                 Opacity="0.8" />
                    </Button>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
