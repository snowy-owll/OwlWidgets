<UserControl
    x:Class="OwlWidgets.Widgets.DeviceBatteryInfo.Content"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OwlWidgets.Widgets.DeviceBatteryInfo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:OwlWidgets.Widgets.DeviceBatteryInfo.Properties;assembly=OwlWidgets.Widgets.DeviceBatteryInfo.Descriptor"
    xmlns:ui="clr-namespace:OwlWidgets.UI.Common;assembly=OwlWidgets.UI.Common"
    xmlns:vms="clr-namespace:OwlWidgets.Widgets.DeviceBatteryInfo.ViewModels"
    d:DataContext="{d:DesignInstance Type=vms:ContentViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OwlWidgets.UI.Common;component/Themes/Card.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Padding="10,5" Style="{StaticResource CardStyle}">
        <Grid Width="300">
            <!--  No device added: a hint and the way to the settings.  -->
            <ui:SettingsPrompt
                Margin="0,3"
                Command="{Binding OpenSettingsCommand}"
                Message="{x:Static p:Strings.Empty_Message}">
                <ui:SettingsPrompt.Style>
                    <Style TargetType="ui:SettingsPrompt">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:SettingsPrompt.Style>
            </ui:SettingsPrompt>

            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vms:DeviceViewModel}">
                        <DockPanel Margin="0,5" HorizontalAlignment="Stretch">
                            <Grid
                                Width="40"
                                Height="40"
                                DockPanel.Dock="Left">
                                <Image x:Name="Icon" Source="{Binding Icon}" />
                                <!--  No icon chosen: the Bluetooth sign in a circle.  -->
                                <Border
                                    x:Name="Sign"
                                    Background="#33FFFFFF"
                                    CornerRadius="20"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="18"
                                        Foreground="White"
                                        Text="&#xE702;" />
                                </Border>
                            </Grid>
                            <StackPanel Margin="10,0,0,0" Orientation="Vertical">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <DockPanel>
                                    <Ellipse
                                        Width="10"
                                        Height="10"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Fill="{Binding Color}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        Foreground="White"
                                        Text="{Binding Status}" />
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Sign" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
